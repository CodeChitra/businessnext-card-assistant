# Copy to .env and fill in. Put machine-specific overrides in .env.local (gitignored too).

# --- LLM (LangChain provider strings: openai:..., anthropic:..., etc.) ---
LLM_PRIMARY_MODEL=openai:gpt-4o-mini
LLM_FALLBACK_MODEL=openai:gpt-4.1-mini
LLM_JUDGE_MODEL=openai:gpt-4.1-mini        # used by evals only
# LLM_FALLBACK_MODEL=none                  # disable fallback (single-model keys)
# LLM_REASONING_EFFORT=low                 # reasoning models only (gpt-5*, o-series)
OPENAI_API_KEY=
# OPENAI_BASE_URL=                         # optional: any OpenAI-compatible gateway
# ANTHROPIC_API_KEY=                       # only if an anthropic: model is configured
# SSL_CERT_FILE=                           # optional: custom CA bundle

# --- Tracing (optional; the app runs without it) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grounded-card-agent
# LANGSMITH_ENDPOINT=                      # optional: self-hosted / regional LangSmith
# EVAL_LANGSMITH_PROJECT=grounded-card-agent-evals

# --- Behaviour ---
# AS_OF_DATE=2026-08-25                    # pin "today" for reproducible rules/evals
# TOOL_TIMEOUT_RATE=0.0833                 # get_account_state timeout rate (~1 in 12)
# TOOL_FAULT_SEED=7                        # deterministic fault pattern
